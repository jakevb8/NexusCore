# ─── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy manifests first for better layer caching
COPY package.json package-lock.json ./
COPY apps/kafka-consumer/package.json ./apps/kafka-consumer/

RUN npm ci

# Copy source
COPY apps/kafka-consumer ./apps/kafka-consumer
COPY tsconfig.base.json ./

# Build with nest build (webpack) from apps/kafka-consumer
# Output: apps/kafka-consumer/dist/main.js
WORKDIR /app/apps/kafka-consumer
RUN npx nest build

# ─── Production stage ─────────────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/kafka-consumer/package.json ./apps/kafka-consumer/

RUN npm ci --omit=dev

# Copy compiled bundle
COPY --from=builder /app/apps/kafka-consumer/dist ./apps/kafka-consumer/dist

CMD ["node", "apps/kafka-consumer/dist/main"]
